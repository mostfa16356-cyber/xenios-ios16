diff --git a/src/xenia/base/ipad9_resource_budget.h b/src/xenia/base/ipad9_resource_budget.h
new file mode 100644
index 000000000..bce605a6e
--- /dev/null
+++ b/src/xenia/base/ipad9_resource_budget.h
@@ -0,0 +1,60 @@
+#ifndef XENIA_BASE_IPAD9_RESOURCE_BUDGET_H_
+#define XENIA_BASE_IPAD9_RESOURCE_BUDGET_H_
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+#include "xenia/base/platform.h"
+#if XE_PLATFORM_IOS
+#include <sys/sysctl.h>
+#endif
+
+namespace xe {
+inline bool IsIPad9ResourceDevice() {
+#if XE_PLATFORM_IOS
+  static const bool matched = [] {
+    char model[64] = {};
+    size_t length = sizeof(model);
+    if (sysctlbyname("hw.machine", model, &length, nullptr, 0) != 0) {
+      return false;
+    }
+    return std::strcmp(model, "iPad12,1") == 0 ||
+           std::strcmp(model, "iPad12,2") == 0;
+  }();
+  return matched;
+#else
+  return false;
+#endif
+}
+
+struct IPad9TextureBudget {
+  uint32_t soft_mb;
+  uint32_t hard_mb;
+  uint32_t unused_seconds;
+  uint32_t pressure_level;
+};
+
+// Advisory cache eviction policy, not an allocation cap. Never destroy a
+// texture still used by an unfinished GPU submission. All values are host
+// texture cache budgets, separate from Xbox 360 guest memory and JIT memory.
+inline IPad9TextureBudget GetIPad9TextureBudget(
+    size_t available_bytes, uint32_t requested_soft_mb,
+    uint32_t requested_hard_mb, uint32_t requested_unused_seconds) {
+  constexpr size_t kMiB = size_t(1) << 20;
+  IPad9TextureBudget budget{96, 192, 2, 0};
+  if (available_bytes < 256 * kMiB) {
+    budget = {24, 32, 0, 2};
+  } else if (available_bytes < 512 * kMiB) {
+    budget = {64, 128, 0, 1};
+  }
+  budget.hard_mb = std::min(budget.hard_mb, requested_hard_mb);
+  budget.soft_mb = std::min(
+      std::min(budget.soft_mb, requested_soft_mb), budget.hard_mb);
+  budget.unused_seconds =
+      std::min(budget.unused_seconds, requested_unused_seconds);
+  return budget;
+}
+}  // namespace xe
+#endif
