diff --git a/CMakeLists.txt b/CMakeLists.txt
index 089b4c90c..c31182dcf 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -17,7 +17,7 @@ endif()
 # Must be set before project() so the toolchain bakes the deployment target into
 # every compile/link; setting it later only updates the variable.
 if(XE_PLATFORM_IOS)
-  set(CMAKE_OSX_DEPLOYMENT_TARGET "18.0" CACHE STRING "Minimum iOS version")
+  set(CMAKE_OSX_DEPLOYMENT_TARGET "16.3" CACHE STRING "Minimum iOS version")
 elseif(XE_PLATFORM_MACOS)
   set(CMAKE_OSX_DEPLOYMENT_TARGET "15.0" CACHE STRING "Minimum macOS version")
 endif()
diff --git a/src/xenia/base/logging.cc b/src/xenia/base/logging.cc
index 38106599e..cc2504620 100644
--- a/src/xenia/base/logging.cc
+++ b/src/xenia/base/logging.cc
@@ -545,6 +545,10 @@ void FatalError(const std::string_view str) {
 #if XE_PLATFORM_ANDROID
   // Throw an error that can be reported to the developers via the store.
   std::abort();
+#elif XE_PLATFORM_IOS
+  // quick_exit is not exported by libSystem on iOS 16.3. Avoid a dyld abort
+  // before main() by using the already-supported immediate exit instead.
+  std::_Exit(EXIT_FAILURE);
 #else
   // skip static destructors so they can't race with worker threads still
   // running and corrupt the heap, at_quick_exit handlers will take care
